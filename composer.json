{
    "name": "tuimedia/page-bundle",
    "description": "An API for managing rich, versioned, multilingual content.",
    "type": "symfony-bundle",
    "homepage": "https://github.com/tuimedia/TuiPageBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Robinson",
            "email": "matt@tuimedia.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tuimedia/TuiPageBundle/issues",
        "source": "https://github.com/tuimedia/TuiPageBundle"
    },
    "autoload": {
        "psr-4": {
            "Tui\\PageBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.8|^4.0",
        "doctrine/doctrine-bundle": "^2.12|^3.0",
        "doctrine/orm": "^2.20|^3.3",
        "opis/json-schema": "^1.2",
        "psr/http-client": "^1.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/doctrine-bridge": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/property-info": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/security-core": "^6.4|^7.0|^8.0",
        "symfony/serializer": "^6.4|^7.0|^8.0",
        "symfony/uid": "^6.4|^7.0|^8.0",
        "symfony/validator": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "typesense/typesense-php": "^4.7 | ^5.0",
        "voku/anti-xss": "^4.1.43"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "rector/rector": "^2.2"
    },
    "suggest": {
        "symfony/security-bundle": "Needed for the default access_roles, which require ROLE_ADMIN for writes and history"
    }
}
