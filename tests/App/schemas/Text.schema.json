{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://api.example.com/Text.schema.json#",
    "type": "object",
    "properties": {
        "title": {
            "type": "string",
            "maxLength": 1024
        },
        "copy": {
            "type": "string",
            "contentMediaType": "text/html",
            "maxLength": 10240
        },
        "count": {
            "type": "integer"
        },
        "shout": {
            "type": "string",
            "contentMediaType": "text/x-shout"
        }
    }
}
