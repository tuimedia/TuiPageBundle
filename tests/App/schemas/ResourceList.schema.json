{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://api.example.com/ResourceList.schema.json#",
  "title": "A list of downloadable resources, with a call to action",
  "type": "object",
  "definitions": {
    "link": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "format": "uri" },
        "newWindow": { "type": "boolean" }
      },
      "required": ["url"]
    }
  },
  "properties": {
    "title": { "type": "string", "maxLength": 200 },
    "intro": { "type": "string", "contentMediaType": "text/html" },
    "strapline": { "type": "string", "contentMediaType": "text/x-shout" },
    "subtitle": { "type": ["string", "null"] },
    "variant": { "type": "string", "enum": ["grid", "list"] },
    "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "featured": { "type": "boolean" },
    "cta": { "$ref": "#/definitions/link" },
    "image": {
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "contentMediaType": "text/html" },
          "fileSize": { "type": "integer" },
          "link": { "$ref": "#/definitions/link" }
        },
        "required": ["title", "link"]
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-z]+Label$": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
